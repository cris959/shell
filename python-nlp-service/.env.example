# =====================================================================
# CONFIGURACIÓN DEL MICROSERVICIO NLP (FastAPI + LLM Fallback)
# =====================================================================

# Configuración del Servidor
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# ---------------------------------------------------------------------
# API KEYS DE PROVEEDORES DE IA (Requerido para la resiliencia)
# ---------------------------------------------------------------------

# Proveedor Primario: Groq Cloud (Modelo: llama-3.3-70b-versatile)
# Obtener clave en: https://console.groq.com/
GROQ_API_KEY=gsk_tu_api_key_de_groq_aqui

# Proveedor Secundario / Fallback: Mistral AI (Modelo: mistral-small-latest)
# Obtener clave en: https://console.mistral.ai/
MISTRAL_API_KEY=tu_api_key_de_mistral_aqui

# ---------------------------------------------------------------------
# INTEGRACIÓN Y DTOs (Formato de Claves JSON para comunicación con Spring)
# ---------------------------------------------------------------------
# Estructura JSON esperada en POST /api/v1/analizar-perfil
# Entrada:  ingresos_totales (float), transacciones (list)
# Salida:   diagnostico (str), nivel_riesgo (str), recomendaciones (list)